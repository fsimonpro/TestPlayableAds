            + vec3(-2.5, -0.5, 1.5);\n    u_xlat5.xyz = u_xlat6.yxz * _ShadowMapTexture_TexelSize.xxx;\n   
            u_xlat1 = u_xlat2.xyxy * _ShadowMapTexture_TexelSize.xyxy + u_xlat5.ywxw;\n   
            u_xlat16.xy = u_xlat2.xy * _ShadowMapTexture_TexelSize.xy + u_xlat5.zw;\n   
